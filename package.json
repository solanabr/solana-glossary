{
  "name": "solana-glossary-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo: @stbr/solana-glossary (SDK + MCP server) and the Solana Glossary web app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/solanabr/solana-glossary"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @stbr/solana-glossary",
    "test": "npm run test -w @stbr/solana-glossary",
    "validate": "npm run validate -w @stbr/solana-glossary",
    "lint": "npm run lint -w @stbr/solana-glossary",
    "release": "npm publish -w @stbr/solana-glossary"
  }
}
