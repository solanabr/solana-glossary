{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/api/meta?path=home" },
    { "source": "/copilot", "destination": "/api/meta?path=copilot" },
    { "source": "/learn", "destination": "/api/meta?path=learn" },
    { "source": "/t/:id", "destination": "/api/meta?path=term&id=:id" },
    {
      "source": "/c/:category",
      "destination": "/api/meta?path=category&category=:category"
    },
    {
      "source": "/c/:category/t/:id",
      "destination": "/api/meta?path=term&id=:id"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
