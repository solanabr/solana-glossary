# ============================================================================
# apps/web — AI backend environment variables
# ============================================================================
# The app runs in dev with none of these set — the AI layer degrades gracefully.
#
# SECURITY: every var below is SERVER-ONLY (readable by the Vercel functions in
# apps/web/api, never bundled into the browser) EXCEPT the two VITE_-prefixed
# flags (VITE_TURNSTILE_SITE_KEY, VITE_AI_ENABLED) — both are public, non-secret,
# and browser-exposed by design. Never put a secret behind a VITE_ prefix — Vite
# inlines it into the client bundle.
#
# Copy this file to `.env` (gitignored) and fill in what you need. Empty values
# below are secrets/connection strings you provide; uncommented values are the
# contract defaults; commented-out lines are unset by default.
# ============================================================================

# --- Open Graph (no config required) ----------------------------------------
# Dynamic OG images (/api/og) and crawler meta (/api/meta) need NO env vars:
# the absolute base URL is derived from the request Host header, so it is
# correct on every preview and production domain automatically. OG images are
# cached immutably for a year — after editing api/og.tsx, bump OG_VERSION in
# api/meta.ts (and the `v=1` defaults in index.html) to invalidate them.

# --- Google Gemini (server-only) --------------------------------------------
# API key for Google Gemini. Absent -> AI disabled (status `disabled`; AI routes
# return the resting state while browse/search/category/graph keep working).
GEMINI_API_KEY=
# Model for copilot / code-explain. Absent -> default shown.
GEMINI_MODEL=gemini-2.5-flash
# Economy model for quiz and degraded tiers. Absent -> default shown.
GEMINI_MODEL_LITE=gemini-2.5-flash-lite

# --- Cloudflare Turnstile — bot gate ----------------------------------------
# Server-only secret used to verify the Turnstile token server-side. Absent ->
# bot gate skipped (server logs a warn); rate limiting still applies.
TURNSTILE_SECRET_KEY=
# PUBLIC / BROWSER var (VITE_-prefixed, non-secret). Turnstile widget site key.
# Absent -> client skips the widget and calls the AI routes directly; requests
# still work in dev.
VITE_TURNSTILE_SITE_KEY=
# PUBLIC / BROWSER var (VITE_-prefixed, non-secret). Client fallback flag for the
# AI UI when GET /api/ai/status can't be reached (e.g. a static build with no
# functions). "true" shows the AI surfaces; absent/other -> treated as off.
VITE_AI_ENABLED=

# --- Session tokens (server-only) -------------------------------------------
# HMAC secret to sign/verify short-lived (~30 min) session tokens. Absent -> an
# ephemeral in-memory secret is used (dev only; server logs a warn).
SESSION_HMAC_SECRET=

# --- Upstash Redis — rate limit + budget + cache store (server-only) ---------
# Absent -> no durable metering; an in-memory best-effort limiter is used and
# production AI is blocked unless ALLOW_UNMETERED_AI=1 (see below).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Vercel Edge Config — runtime kill-switches (server-only) ----------------
# Connection string for runtime feature kill-switches. Absent -> fall back to
# the AI_ENABLED / *_ENABLED env flags below.
EDGE_CONFIG=

# --- Feature flags (server-only; default on) --------------------------------
# Master switch plus per-feature toggles. Absent -> on. Set to `false` to
# disable the corresponding surface.
AI_ENABLED=true
COPILOT_ENABLED=true
QUIZ_ENABLED=true
APPLY_CODE_ENABLED=true

# --- Operator overrides & budgets (server-only) -----------------------------
# Force a serving tier regardless of spend: normal | economy | canned | resting.
# Absent -> no override (tier is derived from budget usage).
# AI_FORCE_TIER=
# Global spend ceilings in USD. Absent -> defaults shown.
AI_DAILY_BUDGET_USD=10
AI_MONTHLY_BUDGET_USD=200
# Per-identity daily spend cap in USD. Absent -> default shown.
AI_USER_DAILY_BUDGET_USD=0.05
# Allow AI to run without Upstash metering in production. Absent/off -> prod AI
# is blocked when Upstash is unconfigured. Set to 1 to override (not advised).
# ALLOW_UNMETERED_AI=1
